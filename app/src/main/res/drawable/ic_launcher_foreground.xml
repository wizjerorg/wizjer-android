            android:pathData="M354.7,472 a145.3,145.3 0 1,0 290.6,0 a145.3,145.3 0 1,0 -290.6,0 Z" />
        <!-- Highlight -->
        <path
            android:fillColor="#EAF8F3"
            android:pathData="M411.07,419.5 a36.43,36.43 0 1,0 72.86,0 a36.43,36.43 0 1,0 -72.86,0 Z" />
    </group>
</vector>
