        <path
            android:fillColor="#0F2E2E"
            android:pathData="M262.13,666.04 A307,307 0 1,1 408.79,765.14 L195.12,838.85 Q185.67,842.11 189.65,832.93 Z" />
        <!-- Eye -->
        <path
