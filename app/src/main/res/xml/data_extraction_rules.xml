<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing from the app goes into cloud backups or device-to-device transfers: the session
    token is tied to this device's keystore, and personal data shouldn't leave the phone this way.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
