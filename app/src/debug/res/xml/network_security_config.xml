<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: allow plain HTTP so the app can talk to a development server on the
    local network (set its address with wizjer.apiUrl in local.properties). Release builds
    use src/main/res/xml/network_security_config.xml, which is HTTPS-only.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
